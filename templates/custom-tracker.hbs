<div class="custom-tracker-config">
  <div class="form-group tracker-intro">
    <p class="notes">
      {{{localize "NTCL.Trackers.Intro"}}}
      <br><br>
      {{{localize "NTCL.Trackers.Placeholders"}}}
      <br><br>
      {{{localize "NTCL.Trackers.Icons"}}}
      <br><br>
      <a href="https://github.com/nschoenwald/niks-tiny-changelogs#%EF%B8%8F-custom-tracked-values" target="_blank"><i class="fa-solid fa-arrow-up-right-from-square"></i> {{localize "NTCL.Trackers.Docs"}}</a>
    </p>
    <table class="tracker-table">
      <thead>
        <tr>
          <th>{{localize "NTCL.Trackers.ColName"}}</th>
          <th>{{localize "NTCL.Trackers.ColPath"}}</th>
          <th>{{localize "NTCL.Trackers.ColGain"}}</th>
          <th>{{localize "NTCL.Trackers.ColLoss"}}</th>
          <th>{{localize "NTCL.Trackers.ColIcon"}}</th>
          <th>{{localize "NTCL.Trackers.ColColor"}}</th>
          <th><a class="tracker-action" data-action="addResource" data-tooltip="NTCL.Trackers.Add" aria-label="{{localize 'NTCL.Trackers.Add'}}"><i class="fa-solid fa-plus"></i></a></th>
        </tr>
      </thead>
      <tbody>
        {{#each resources}}
        <tr class="tracker-row" data-index="{{@index}}">
          <td><input type="text" name="resources.{{@index}}.name" value="{{this.name}}" required /></td>
          <td><input type="text" name="resources.{{@index}}.path" value="{{this.path}}" required /></td>
          <td><input type="text" name="resources.{{@index}}.msgGain" value="{{this.msgGain}}" required /></td>
          <td><input type="text" name="resources.{{@index}}.msgLoss" value="{{this.msgLoss}}" required /></td>
          <td>
            <div class="tracker-icon-field">
              <input type="text" name="resources.{{@index}}.icon" value="{{this.icon}}" required placeholder="{{localize 'NTCL.Trackers.IconPlaceholder'}}" />
              <button type="button" class="custom-file-picker" data-action="browseIcon" data-target="resources.{{@index}}.icon" data-tooltip="NTCL.Trackers.Browse" aria-label="{{localize 'NTCL.Trackers.Browse'}}" tabindex="-1">
                <i class="fas fa-file-import fa-fw"></i>
              </button>
            </div>
          </td>
          <td><input type="color" name="resources.{{@index}}.color" value="{{this.color}}" required /></td>
          <td class="tracker-row-actions"><a class="tracker-action" data-action="deleteResource" data-tooltip="NTCL.Trackers.Delete" aria-label="{{localize 'NTCL.Trackers.Delete'}}"><i class="fa-solid fa-trash"></i></a></td>
        </tr>
        {{else}}
        <tr><td colspan="7" class="tracker-empty">{{localize "NTCL.Trackers.Empty"}}</td></tr>
        {{/each}}
      </tbody>
    </table>
  </div>
  <input type="file" class="tracker-import-file-input" accept=".json" hidden />
  <footer class="sheet-footer flexrow tracker-footer">
    <div class="tracker-footer-actions">
      <button type="button" class="tracker-export-btn" data-action="exportTrackers" data-tooltip="NTCL.Trackers.ExportHint">
        <i class="fas fa-file-export"></i> {{localize "NTCL.Trackers.Export"}}
      </button>
      <button type="button" class="tracker-import-btn" data-action="importTrackers" data-tooltip="NTCL.Trackers.ImportHint">
        <i class="fas fa-file-import"></i> {{localize "NTCL.Trackers.Import"}}
      </button>
    </div>
    <button type="submit" class="tracker-save-btn">
      <i class="fas fa-save"></i> {{localize "NTCL.Trackers.Save"}}
    </button>
  </footer>
</div>
