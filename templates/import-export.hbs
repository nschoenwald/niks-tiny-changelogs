<div class="import-export-form">
  <p class="notes import-export-intro">
    {{{localize "NTCL.ImportExport.Intro"}}}
  </p>

  <!-- EXPORT SECTION -->
  <div class="import-export-section export-box">
    <div class="section-header">
      <i class="fas fa-file-export fa-fw"></i>
      <h3>{{localize "NTCL.ImportExport.ExportHeading"}}</h3>
    </div>
    <p class="section-desc">
      {{localize "NTCL.ImportExport.ExportDesc"}}
    </p>

    <div class="stats-grid">
      <div class="stat-pill">
        <span class="stat-label">{{localize "NTCL.ImportExport.Version"}}</span>
        <span class="stat-value">v{{moduleVersion}}</span>
      </div>
      <div class="stat-pill">
        <span class="stat-label">{{localize "NTCL.ImportExport.ActiveSystem"}}</span>
        <span class="stat-value">{{systemTitle}}</span>
      </div>
      <div class="stat-pill">
        <span class="stat-label">{{localize "NTCL.ImportExport.Settings"}}</span>
        <span class="stat-value">{{localize "NTCL.ImportExport.SettingsCount" count=settingsCount}}</span>
      </div>
      <div class="stat-pill">
        <span class="stat-label">{{localize "NTCL.ImportExport.CustomTrackers"}}</span>
        <span class="stat-value">{{localize "NTCL.ImportExport.TrackersCount" count=customTrackerCount}}</span>
      </div>
    </div>

    <div class="action-row">
      <button type="button" class="btn-action btn-export" data-action="exportAll">
        <i class="fas fa-file-export"></i> {{localize "NTCL.ImportExport.ExportButton"}}
      </button>
    </div>
  </div>

  <hr class="section-divider" />

  <!-- IMPORT SECTION -->
  <div class="import-export-section import-box">
    <div class="section-header">
      <i class="fas fa-file-import fa-fw"></i>
      <h3>{{localize "NTCL.ImportExport.ImportHeading"}}</h3>
    </div>
    <p class="section-desc">
      {{{localize "NTCL.ImportExport.ImportDesc"}}}
    </p>

    <div class="form-group tracker-mode-group">
      <label class="mode-title"><strong>{{localize "NTCL.ImportExport.TrackerMode"}}</strong></label>
      <div class="mode-options">
        <label class="radio-label">
          <input type="radio" name="trackerMode" value="replace" checked />
          <span>{{{localize "NTCL.ImportExport.ModeReplace"}}}</span>
        </label>
        <label class="radio-label">
          <input type="radio" name="trackerMode" value="merge" />
          <span>{{{localize "NTCL.ImportExport.ModeMerge"}}}</span>
        </label>
      </div>
    </div>

    <input type="file" class="import-file-input" accept=".json" hidden />

    <div class="action-row">
      <button type="button" class="btn-action btn-import" data-action="selectFile">
        <i class="fas fa-upload"></i> {{localize "NTCL.ImportExport.ImportButton"}}
      </button>
    </div>
  </div>
</div>
